{
  "name": "dsh-plugin-miku-theme",
  "version": "0.4.3",
  "description": "DeepSeek Harness 初音未来、玫瑰女王与丝柯克三主题套装，内置统一主题管理、手机布局及电脑与手机独立启动视频上传",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json",
    "./themes/rose/skin.json": "./themes/rose/skin.json"
  },
  "files": [
    "lib",
    "assets",
    "skin.json",
    "cordis.patch.yml",
    "preview",
    "screenshots.json",
    "README.md",
    "design-qa.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES",
    "src",
    "scripts",
    "test",
    "integrated",
    "media",
    "themes",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "0.27.7",
    "jsdom": "27.4.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "ekkoSkinProvider": 1,
    "ekkoSkins": [
      "miku",
      "rose",
      "skirk"
    ]
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjjchina3088191870-sudo/dsh-plugin-miku-theme.git"
  },
  "homepage": "https://github.com/cjjchina3088191870-sudo/dsh-plugin-miku-theme#readme",
  "bugs": {
    "url": "https://github.com/cjjchina3088191870-sudo/dsh-plugin-miku-theme/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "miku",
    "rose-queen",
    "skirk"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
